.transcripts/

# fathom metric cache (local only): docs/adr/0006-fathom-workspace-layout.md
# Everything under .fathom/ is disposable cache; the only committed file is LAYOUT.md, the
# on-disk contract that lives inside the cache root. Any other whitelist entry here must be
# listed in that ADR's §12 or it is dead: scripts/validate_fathom_layout.py says so.
.fathom/*
!.fathom/LAYOUT.md

__pycache__/
*.pyc

# act-mcp evidence (local only)
# Local runs of act-mcp write .evidence/ into whatever workspace they point at,
# including this repo when it is used as a fixture workspace. Layout and rules:
# docs/adr/0002-evidence-jsonl-contract.md §6.4. .act-mcp.lock is the workspace
# run lock: docs/adr/0003-commit-isolation-and-serialization.md §6.
.evidence/
.act-mcp.lock

# cargo build artefacts
/target

# what `scripts/coverage.sh` and `scripts/bench.sh` write when they are run by hand: inside a run
# $ACTMCP_EVIDENCE_OUT is set and they write into the evidence tree instead (ADR-0002 §3.2, §3.3)
/lcov.info
/benchmark.json

# the harness's own act-mcp log when this checkout is used as a fixture workspace: an untracked
# file here is a dirty worktree to the act runner (isolation_failed: dirty_worktree)
mact.log
.pi/*

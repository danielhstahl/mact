{
  "act": {
    "argv": [
      "{ACT_BINARY}",
      "--directory",
      "{WORKSPACE}",
      "--workflows",
      "{WORKSPACE}/.github/workflows/coverage.yml",
      "--job",
      "coverage",
      "--bind",
      "--reuse=false",
      "--rm",
      "--pull=false",
      "--rebuild",
      "--use-gitignore",
      "--json",
      "--quiet=false",
      "--secret-file",
      "{SCRATCH}/{RUN_ID}/secrets.env",
      "--var-file",
      "{SCRATCH}/{RUN_ID}/inert.conf",
      "--env-file",
      "{SCRATCH}/{RUN_ID}/inert.conf",
      "--input-file",
      "{SCRATCH}/{RUN_ID}/inert.conf",
      "--env",
      "ACTMCP_EVIDENCE_OUT={EVIDENCE}/incoming/{RUN_ID}",
      "--env",
      "ACTMCP_RUN_ID={RUN_ID}"
    ],
    "log": "runs/{RUN_ID}/act.jsonl",
    "log_bytes": {NUMBER},
    "log_truncated": false,
    "pid": {NUMBER}
  },
  "category": "other",
  "commit": "{COMMIT}",
  "duration_ms": {NUMBER},
  "evidence": [],
  "exit_code": 0,
  "host": "{HOST}",
  "incoming": {
    "dir": "incoming/{RUN_ID}",
    "files": [
      {
        "bytes": 280,
        "path": "lcov.info"
      }
    ],
    "removed": false
  },
  "run_id": "{RUN_ID}",
  "schema_version": 1,
  "started_at": "{TS}",
  "status": "success",
  "task": "coverage",
  "warnings": [
    "unknown_category"
  ],
  "workflow": "coverage"
}
